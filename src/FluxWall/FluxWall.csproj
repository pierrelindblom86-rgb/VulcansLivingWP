<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>FluxWall</RootNamespace>
    <!-- Public executable name. The internal namespace stays FluxWall; it never
         appears in the UI, on disk, or in any release artifact. -->
    <AssemblyName>VulcansLivingWP</AssemblyName>
    <Version>1.2.3.0</Version>
    <FileVersion>1.2.3.0</FileVersion>
    <AssemblyVersion>1.2.3.0</AssemblyVersion>
    <InformationalVersion>1.2.3</InformationalVersion>
    <Product>VulcansLivingWP — Free Live Wallpaper</Product>
    <Company>VulcansLivingWP</Company>
    <Copyright>Copyright © 2026 VulcansLivingWP</Copyright>
    <Description>Free, lightweight animated video wallpaper for Windows 10/11.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
