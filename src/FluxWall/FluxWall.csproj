<Project Sdk="Microsoft.NET.Sdk">

  <!-- The only place the product version is written down. -->
  <Import Project="..\..\version.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>FluxWall</RootNamespace>
    <!-- Public executable name. The internal namespace stays FluxWall; it never
         appears in the UI, on disk, or in any release artifact. -->
    <AssemblyName>VulcansLivingWP</AssemblyName>
    <!-- $(VulcanVersion) is "1.3.0"; the Windows version fields need four parts. -->
    <Version>$(VulcanVersion)</Version>
    <FileVersion>$(VulcanVersion).0</FileVersion>
    <AssemblyVersion>$(VulcanVersion).0</AssemblyVersion>
    <InformationalVersion>$(VulcanVersion)</InformationalVersion>
    <Product>VulcansLivingWP — Free Live Wallpaper</Product>
    <Company>VulcansLivingWP</Company>
    <Copyright>Copyright © 2026 VulcansLivingWP</Copyright>
    <Description>Free, lightweight animated video wallpaper for Windows 10/11.</Description>
    <!-- ApplicationManifest is set by the GenerateAppManifest target below,
         because IntermediateOutputPath is not known this early. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- 64-bit only (Windows 10/11 64-bit per the README); explicit optimizations
         for Release builds so the JIT inlines and registers-allocates the hot
         decode/render path. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <PlatformTarget Condition="'$(Configuration)' == 'Release'">x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <!--
    The application manifest must carry a well-formed assembly version (Windows
    refuses to load the exe otherwise), so it is generated instead of checked in
    with a hand-edited number.
  -->
  <Target Name="GenerateAppManifest" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ManifestText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\app.manifest.template').Replace('@VERSION@', '$(VulcanVersion).0'))</_ManifestText>
      <ApplicationManifest>$(IntermediateOutputPath)app.manifest</ApplicationManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)app.manifest"
                      Lines="$(_ManifestText)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <!-- JavaScriptSerializer, used by the GitHub update checker. -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
